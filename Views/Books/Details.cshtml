@model TestExamApp.Models.Book

@{
    ViewData["Title"] = "Detaljer";
}

<h1 class="mb-3">Detaljer</h1>

<div>
    <h4>Bokinformasjon</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Tittel</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Forfatter</dt>
        <dd class="col-sm-9">@Model.Author</dd>

        <dt class="col-sm-3">ISBN</dt>
        <dd class="col-sm-9">@Model.Isbn</dd>

        <dt class="col-sm-3">Utgivelsesår</dt>
        <dd class="col-sm-9">@Model.PublishedYear</dd>

        <dt class="col-sm-3">Bibliotek</dt>
        <dd class="col-sm-9">@Model.Library?.Name</dd>
    </dl>
</div>

<div class="mt-3">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            Rediger
        </a>
    }

    <a asp-action="Index" class="btn btn-secondary">
        Tilbake
    </a>
</div>