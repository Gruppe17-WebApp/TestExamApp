@model TestExamApp.Models.Book

@{
    ViewData["Title"] = "Slett bok";
}

<h1>Slett</h1>

<h3 class="text-danger">Er du sikker på at du vil slette denne?</h3>

<div>
    <h4>Bok</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Tittel</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Forfatter</dt>
        <dd class="col-sm-9">@Model.Author</dd>

        <dt class="col-sm-3">ISBN</dt>
        <dd class="col-sm-9">@Model.Isbn</dd>

        <dt class="col-sm-3">Utgivelsesår</dt>
        <dd class="col-sm-9">@Model.PublishedYear</dd>

        <dt class="col-sm-3">Bibliotek</dt>
        <dd class="col-sm-9">@Model.Library.City</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <input type="submit" value="Slett" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Tilbake</a>
    </form>
</div>