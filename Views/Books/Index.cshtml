@model IEnumerable<TestExamApp.Models.Book>

@{
    ViewData["Title"] = "Bøker";
}

<h1 class="mb-3">Bøker</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Opprett ny bok</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Tittel</th>
            <th>Forfatter</th>
            <th>ISBN</th>
            <th>Utgivelsesår</th>
            <th>Bibliotek</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Title</td>
            <td>@item.Author</td>
            <td>@item.Isbn</td>
            <td>@item.PublishedYear</td>
            <td>@item.Library?.Name</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Rediger</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detaljer</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Slett</a>
            </td>
        </tr>
}
    </tbody>
</table>