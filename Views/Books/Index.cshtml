@model IEnumerable<TestExamApp.Models.Book>

@{
    ViewData["Title"] = "Bøker";
}

<h1 class="mb-3">Bøker</h1>

@if (User.Identity.IsAuthenticated)
{
    <p>
        <a asp-action="Create" class="btn btn-primary mb-3">
            + Opprett ny bok
        </a>
    </p>
}

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Tittel</th>
            <th>Forfatter</th>
            <th>ISBN</th>
            <th>Utgivelsesår</th>
            <th>Bibliotek</th>
            <th class="text-center">Handling</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Title</td>
            <td>@item.Author</td>
            <td>@item.Isbn</td>
            <td>@item.PublishedYear</td>
            <td>@item.Library?.Name</td>
            <td class="text-center">

                <a asp-action="Details" asp-route-id="@item.Id"
                   class="btn btn-sm btn-details me-1">
                    Detaljer
                </a>

                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-sm btn-edit me-1">
                        Rediger
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-sm btn-delete">
                        Slett
                    </a>
                }

            </td>
        </tr>
}
    </tbody>
</table>