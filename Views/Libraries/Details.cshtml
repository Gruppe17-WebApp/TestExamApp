@model TestExamApp.Models.Library

@{
    ViewData["Title"] = "Detaljer";
}

<h1 class="mb-3">Detaljer</h1>

<div>
    <h4 class="text-muted">Bibliotek</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Navn</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">By</dt>
        <dd class="col-sm-9">@Model.City</dd>
    </dl>
</div>

<div class="d-flex gap-2">
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-edit">
            Rediger
        </a>
    }

    <a asp-action="Index" class="btn btn-secondary">
        Tilbake
    </a>
</div>