@model IEnumerable<TestExamApp.Models.Library>

@{
    ViewData["Title"] = "Biblioteker";
}

<h1>Biblioteker</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Opprett nytt bibliotek</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Navn</th>
            <th>By</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Name</td>
            <td>@item.City</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Rediger</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detaljer</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Slett</a>
            </td>
        </tr>
}
    </tbody>
</table>