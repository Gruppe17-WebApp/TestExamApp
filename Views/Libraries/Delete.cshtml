@model TestExamApp.Models.Library

@{
    ViewData["Title"] = "Slett bibliotek";
}

<h1>Slett bibliotek</h1>

<h3 class="text-danger">Er du sikker på at du vil slette dette?</h3>

<div>
    <h4>Bibliotek</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Navn</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">By</dt>
        <dd class="col-sm-9">@Model.City</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <input type="submit" value="Slett" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Tilbake</a>
    </form>
</div>