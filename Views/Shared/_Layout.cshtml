<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bibliotekssystem</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestExamApp.styles.css" asp-append-version="true" />
</head>
<body>

<header>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Bibliotekssystem
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                <!-- VENSTRE -->
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Hjem</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Books" asp-action="Index">Bøker</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Libraries" asp-action="Index">Biblioteker</a>
                    </li>
                </ul>

                <!-- HØYRE -->
                <ul class="navbar-nav">
                    <partial name="_LoginPartial" />
                </ul>

            </div>
        </div>
    </nav>
</header>

<!-- VIKTIG: main er flex-element -->
<main role="main" class="flex-fill">
    <div class="container mt-4">
        <div class="card shadow-sm p-4" style="border-radius: 15px;">
            @RenderBody()
        </div>
    </div>
</main>

<footer class="border-top footer text-muted">
    <div class="container text-center">
        &copy; 2026 - Bibliotekssystem
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>